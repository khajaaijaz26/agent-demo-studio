{
  "name": "agent-demo-studio",
  "version": "0.2.0",
  "description": "Local-first MCP, CLI, and visual studio for AI agents to record product demos and create YouTube, Shorts, Reels, and TikTok videos.",
  "type": "module",
  "license": "MIT",
  "author": "Agent Demo Studio contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khajaaijaz26/agent-demo-studio.git"
  },
  "bugs": {
    "url": "https://github.com/khajaaijaz26/agent-demo-studio/issues"
  },
  "homepage": "https://github.com/khajaaijaz26/agent-demo-studio#readme",
  "keywords": [
    "mcp",
    "codex",
    "claude-code",
    "screen-recorder",
    "product-demo",
    "playwright",
    "video-editing",
    "ai-agent",
    "youtube-shorts",
    "instagram-reels",
    "tiktok",
    "ffmpeg",
    "video-automation"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "agent-demo": "dist/cli.js",
    "agent-demo-mcp": "dist/mcp/entry.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    ".env.example",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-static.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:creator": "npm run build && node scripts/creator-smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
