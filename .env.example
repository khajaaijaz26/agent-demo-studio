# Optional local paths. Local system voices and generated music need no API key.
AGENT_DEMO_HOME=
AGENT_DEMO_FFMPEG=
AGENT_DEMO_FFPROBE=
AGENT_DEMO_WHISPER=
AGENT_DEMO_META_API_VERSION=v23.0

# Optional zero-token local planning. Only loopback Ollama URLs and non-cloud
# model tags are accepted. Fast mode prefers qwen3.5:0.8b.
AGENT_DEMO_PLANNER_PROVIDER=auto
AGENT_DEMO_PLANNER_PROFILE=fast
AGENT_DEMO_OLLAMA_URL=http://127.0.0.1:11434
AGENT_DEMO_OLLAMA_MODEL=qwen3.5:0.8b
AGENT_DEMO_OLLAMA_KEEP_ALIVE=30m

# Optional loopback adapters around locally installed media and voice engines.
# See docs/LOCAL-AI.md for their small JSON contracts.
AGENT_DEMO_MEDIA_ADAPTER_URL=
AGENT_DEMO_VOICE_CLONE_URL=

# Optional true-video engines. LTX Desktop normally listens on 41954. ComfyUI
# requires an API-format workflow JSON containing a {{PROMPT}} placeholder.
AGENT_DEMO_LTX_DESKTOP_URL=http://127.0.0.1:41954
AGENT_DEMO_COMFYUI_URL=http://127.0.0.1:8188
AGENT_DEMO_COMFYUI_WORKFLOW=

# Wan-Animate-2 is reference-image + driving-video character animation, not a
# general text-to-video replacement. Configure it only on suitable GPU hardware.
AGENT_DEMO_WAN_ANIMATE_MODEL_PATH=
AGENT_DEMO_WAN_ANIMATE_ADAPTER_URL=

# Optional publishing credentials. Supply these to the running process through
# a secret manager or private environment; never commit real values.
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
